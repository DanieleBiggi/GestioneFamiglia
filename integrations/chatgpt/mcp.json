{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "gestione-famiglia": {
      "type": "streamable-http",
      "url": "https://www.gestionefamiglia.it/Gestionale25/api/mcp.php",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "resource": "https://www.gestionefamiglia.it/Gestionale25/api/mcp.php",
            "baseScopes": [
              "family:read",
              "family:write"
            ]
          }
        }
      }
    }
  }
}
